<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Conteúdo Principal -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D0E15">

        <!-- Barra Superior (Top Bar) -->
        <RelativeLayout
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#0B0E15"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- Hamburger Menu Button -->
            <Button
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:text="≡"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Logo Wave (ı|ı) + Title (Halla) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_toEndOf="@+id/btnMenu"
                android:layout_marginStart="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ı|ı "
                    android:textColor="#8B5CF6"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Halla"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Botões à Direita (Add + Convidar) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAddServer"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="10dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnQuickConnect"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:text="➦"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnInviteMembers"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="10dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:text="👤+"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnDisconnect"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:text="🔌"
                    android:textColor="#EF4444"
                    android:textSize="16sp"
                    android:visibility="gone" />

            </LinearLayout>

        </RelativeLayout>

        <!-- Corpo da Home (Lista de Servidores) -->
        <RelativeLayout
            android:id="@+id/layoutConnect"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/topAppBar"
            android:visibility="visible">

            <!-- Estado Vazio (Empty State) -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nenhum servidor salvo.\nClique no '+' para adicionar."
                    android:textColor="#8B959E"
                    android:textSize="16sp"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Lista Rolável de Cartões de Servidores -->
            <ScrollView
                android:id="@+id/scrollServers"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/containerServers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </ScrollView>

            <TextView
                android:id="@+id/txtError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:background="#1E1E24"
                android:padding="12dp"
                android:textColor="#D9534F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </RelativeLayout>

        <!-- ============================================================================ -->
        <!-- TELA DO SERVIDOR CONECTADO (CÓPIA FIEL 100% IDÊNTICA AO PRINT MOCKUP)         -->
        <!-- ============================================================================ -->
        <RelativeLayout
            android:id="@+id/layoutServer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/topAppBar"
            android:background="#0D0E15"
            android:visibility="gone">

            <!-- Card de Destaque do Servidor (Top Banner Gradiente Metálico Roxo) -->
            <RelativeLayout
                android:id="@+id/layoutServerBanner"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:padding="16dp">

                <!-- Logo Roxo Esférico Circular -->
                <RelativeLayout
                    android:id="@+id/bannerLogoLayout"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="#151322">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="ı|ı"
                        android:textColor="#8B5CF6"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </RelativeLayout>

                <!-- Textos e Subtítulos -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    android:layout_toEndOf="@+id/bannerLogoLayout"
                    android:layout_toStartOf="@+id/btnBannerSettings"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtActiveServerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Servidor Halla"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtActiveMotd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Bem-vindo ao servidor Halla!"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />

                    <!-- Badges Inferiores Translúcidas do Card -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <!-- Badge Online -->
                        <TextView
                            android:id="@+id/txtCardOnlineBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#151322"
                            android:paddingStart="10dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="3dp"
                            android:text="🟢 Online"
                            android:textColor="#22C55E"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <!-- Badge Membros -->
                        <TextView
                            android:id="@+id/txtActiveUsersCountBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="#151322"
                            android:paddingStart="10dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="3dp"
                            android:text="👤 2 membros"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Ícone Engrenagem Opções -->
                <Button
                    android:id="@+id/btnBannerSettings"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:text="⚙️"
                    android:textColor="#94A3B8"
                    android:textSize="18sp" />

            </RelativeLayout>

            <!-- Categoria: CANAIS DE VOZ -->
            <RelativeLayout
                android:id="@+id/layoutCategoryHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/layoutServerBanner"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp">

                <!-- Seta + Onda + Texto CANAIS DE VOZ -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="∨  "
                        android:textColor="#8B5CF6"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ı|ı  "
                        android:textColor="#8B5CF6"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CANAIS DE VOZ"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Badge Contadora (Direita) + Seta de Recolhimento -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtCategoryChannelsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#151322"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:text="2"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="∧"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </RelativeLayout>

            <!-- Lista de Canais (Cards) -->
            <ScrollView
                android:id="@+id/scrollChannels"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/layoutBottomBar"
                android:layout_below="@+id/layoutCategoryHeader"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/containerChannels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </ScrollView>

            <!-- DOCK FLUTUANTE DE CONTROLES (CÓPIA IDÊNTICA DO PRINT - ARREDONDADO) -->
            <LinearLayout
                android:id="@+id/layoutBottomBar"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:background="#141322"
                android:elevation="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                    <!-- Módulo 1: Desativar Microfone -->
                    <LinearLayout
                        android:id="@+id/btnMuteMicModule"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?android:attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtMicIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎙️"
                            android:textColor="#EF4444"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/txtMicText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Desativar"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Módulo 2: Fones -->
                    <LinearLayout
                        android:id="@+id/btnDeafenModule"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?android:attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtDeafenIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎧"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/txtDeafenText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Fones"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Módulo 3: Destaque Central PTT Roxo TS3/Mumla -->
                    <LinearLayout
                        android:id="@+id/btnPttModule"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1.4"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="#8B5CF6"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ı|ı"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtPttText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FALANDO"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Módulo 4: Mensagens -->
                    <LinearLayout
                        android:id="@+id/btnOpenChatModule"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?android:attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💬"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Mensagens"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Módulo 5: Gravar -->
                    <LinearLayout
                        android:id="@+id/btnRecordModule"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?android:attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtRecordIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔴"
                            android:textColor="#EF4444"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/txtRecordText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Gravar"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

            </LinearLayout>

            <!-- ============================================================================ -->
            <!-- PAINEL DESLIZANTE DE CHAT (SLIDE-UP BOTTOM SHEET / OVERLAY)                  -->
            <!-- ============================================================================ -->
            <RelativeLayout
                android:id="@+id/layoutChatOverlay"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:layout_alignParentBottom="true"
                android:background="#141322"
                android:clickable="true"
                android:elevation="24dp"
                android:focusable="true"
                android:padding="12dp"
                android:visibility="gone">

                <!-- Header do Chat Overlay -->
                <RelativeLayout
                    android:id="@+id/chatOverlayHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="Mensagens de Texto"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnCloseChat"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:text="✕"
                        android:textColor="#94A3B8"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </RelativeLayout>

                <!-- Divisor -->
                <View
                    android:id="@+id/chatDiv"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/chatOverlayHeader"
                    android:background="#3E434A" />

                <!-- Histórico de Chat Rolável -->
                <ScrollView
                    android:id="@+id/scrollChat"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@+id/chatInputRow"
                    android:layout_below="@+id/chatDiv"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/txtChatBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#DCDFE3"
                        android:textSize="13sp" />

                </ScrollView>

                <!-- Campo de digitação inferior -->
                <LinearLayout
                    android:id="@+id/chatInputRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/editChatMsg"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="#0D0E15"
                        android:hint="Escreva uma mensagem..."
                        android:inputType="text"
                        android:padding="10dp"
                        android:textColor="#DCDFE3"
                        android:textColorHint="#5E636A" />

                    <Button
                        android:id="@+id/btnSendChat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="#8B5CF6"
                        android:text="Enviar"
                        android:textColor="#FFFFFF" />

                </LinearLayout>

            </RelativeLayout>

        </RelativeLayout>

    </RelativeLayout>

    <!-- Gaveta Lateral (Navigation Drawer) -->
    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#1E1E24"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Halla Mobile"
            android:textColor="#2E7FC4"
            android:textSize="24sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="16dp"
            android:background="#3E434A" />

        <!-- Opção: Configurações -->
        <TextView
            android:id="@+id/btnNavSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:text="⚙️   Configurações"
            android:textColor="#DCDFE3"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Opção: Ajuda -->
        <TextView
            android:id="@+id/btnNavHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:text="❓   Ajuda"
            android:textColor="#DCDFE3"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackground" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="v1.0.6"
            android:textColor="#5E636A"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
