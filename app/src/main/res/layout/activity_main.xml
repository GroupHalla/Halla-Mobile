<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Conteúdo Principal -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121212">

        <!-- Barra Superior (Top Bar) -->
        <RelativeLayout
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#1E1E24"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <Button
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:text="≡"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/btnMenu"
                android:layout_marginStart="16dp"
                android:text="Halla"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAddServer"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnQuickConnect"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:text="➦"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </RelativeLayout>

        <!-- Corpo da Home (Lista de Servidores) -->
        <RelativeLayout
            android:id="@+id/layoutConnect"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/topAppBar"
            android:visibility="visible">

            <!-- Estado Vazio (Empty State) -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nenhum servidor salvo.\nClique no '+' para adicionar."
                    android:textColor="#8B959E"
                    android:textSize="16sp"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Lista Rolável de Cartões de Servidores -->
            <ScrollView
                android:id="@+id/scrollServers"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/containerServers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </ScrollView>

            <TextView
                android:id="@+id/txtError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:background="#1E1E24"
                android:padding="12dp"
                android:textColor="#D9534F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </RelativeLayout>

        <!-- ============================================================================ -->
        <!-- TELA DO SERVIDOR CONECTADO (REDESENHADA - ESTILO TS3/MUMLA)                  -->
        <!-- ============================================================================ -->
        <RelativeLayout
            android:id="@+id/layoutServer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/topAppBar"
            android:background="#121212"
            android:visibility="gone">

            <!-- Header discreto com Desconectar no canto direito -->
            <RelativeLayout
                android:id="@+id/serverHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1E1E24"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/btnDisconnect"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtActiveServerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Servidor Halla"
                        android:textColor="#DCDFE3"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtActiveMotd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bem-vindo ao servidor!"
                        android:textColor="#8B959E"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnDisconnect"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:text="🔌"
                    android:textColor="#D9534F"
                    android:textSize="20sp" />

            </RelativeLayout>

            <!-- Área Principal (80% de Altura) - Árvore de Canais e Usuários -->
            <ScrollView
                android:id="@+id/scrollChannels"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/layoutBottomBar"
                android:layout_below="@+id/serverHeader"
                android:layout_margin="12dp"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/containerChannels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </ScrollView>

            <!-- Barra de Ação Inferior Fixa (Footer) -->
            <LinearLayout
                android:id="@+id/layoutBottomBar"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_alignParentBottom="true"
                android:background="#1E1E24"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <!-- Botão 1: Microfone (Mute) -->
                <Button
                    android:id="@+id/btnMuteMic"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:text="🎙️"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <!-- Botão 2: Fone/Deafen (Mute som do app) -->
                <Button
                    android:id="@+id/btnDeafen"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:text="🎧"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <!-- Botão 3: PTT / Botão Central Azul de Acionamento -->
                <Button
                    android:id="@+id/btnPtt"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.5"
                    android:backgroundTint="#2563EB"
                    android:text="FALANDO"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Botão 4: Balão de Chat (Slide-up Bottom Sheet) -->
                <Button
                    android:id="@+id/btnOpenChat"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:text="💬"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <!-- Botão 5: Record/Config -->
                <Button
                    android:id="@+id/btnRecord"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:text="🔴"
                    android:textColor="#D9534F"
                    android:textSize="18sp" />

            </LinearLayout>

            <!-- ============================================================================ -->
            <!-- PAINEL DESLIZANTE DE CHAT (SLIDE-UP BOTTOM SHEET / OVERLAY)                  -->
            <!-- ============================================================================ -->
            <RelativeLayout
                android:id="@+id/layoutChatOverlay"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:layout_alignParentBottom="true"
                android:background="#1E1E24"
                android:clickable="true"
                android:elevation="16dp"
                android:focusable="true"
                android:padding="12dp"
                android:visibility="gone">

                <!-- Header do Chat Overlay -->
                <RelativeLayout
                    android:id="@+id/chatOverlayHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="Chat do Canal"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnCloseChat"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:text="✕"
                        android:textColor="#8B959E"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </RelativeLayout>

                <!-- Divisor -->
                <View
                    android:id="@+id/chatDiv"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/chatOverlayHeader"
                    android:background="#3E434A" />

                <!-- Histórico de Chat Rolável -->
                <ScrollView
                    android:id="@+id/scrollChat"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@+id/chatInputRow"
                    android:layout_below="@+id/chatDiv"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/txtChatBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#DCDFE3"
                        android:textSize="13sp" />

                </ScrollView>

                <!-- Campo de digitação inferior -->
                <LinearLayout
                    android:id="@+id/chatInputRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/editChatMsg"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="#121212"
                        android:hint="Escreva uma mensagem..."
                        android:inputType="text"
                        android:padding="10dp"
                        android:textColor="#DCDFE3"
                        android:textColorHint="#5E636A" />

                    <Button
                        android:id="@+id/btnSendChat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="#2563EB"
                        android:text="Enviar"
                        android:textColor="#FFFFFF" />

                </LinearLayout>

            </RelativeLayout>

        </RelativeLayout>

    </RelativeLayout>

    <!-- Gaveta Lateral (Navigation Drawer) -->
    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#1E1E24"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Halla Mobile"
            android:textColor="#2E7FC4"
            android:textSize="24sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="16dp"
            android:background="#3E434A" />

        <!-- Opção: Configurações -->
        <TextView
            android:id="@+id/btnNavSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:text="⚙️   Configurações"
            android:textColor="#DCDFE3"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Opção: Ajuda -->
        <TextView
            android:id="@+id/btnNavHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:text="❓   Ajuda"
            android:textColor="#DCDFE3"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackground" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="v1.0.5"
            android:textColor="#5E636A"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
