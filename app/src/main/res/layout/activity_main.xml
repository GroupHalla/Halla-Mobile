<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_match"
    android:layout_height="match_parent"
    android:background="#1E2125"
    android:padding="16dp">

    <!-- ========================================== -->
    <!-- TELA DE CONEXÃO (LOBBY)                    -->
    <!-- ========================================== -->
    <LinearLayout
        android:id="@+id/layoutConnect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HALLA"
            android:textColor="#2E7FC4"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="Comunicação VoIP Nativa de Alta Performance"
            android:textColor="#8B959E"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/editNick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#24272C"
            android:hint="Apelido (Nickname)"
            android:inputType="text"
            android:padding="14dp"
            android:textColor="#DCDFE3"
            android:textColorHint="#5E636A" />

        <EditText
            android:id="@+id/editAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#24272C"
            android:hint="Endereço do Servidor (IP)"
            android:inputType="text"
            android:padding="14dp"
            android:textColor="#DCDFE3"
            android:textColorHint="#5E636A" />

        <EditText
            android:id="@+id/editPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#24272C"
            android:hint="Porta"
            android:inputType="number"
            android:padding="14dp"
            android:textColor="#DCDFE3"
            android:textColorHint="#5E636A" />

        <EditText
            android:id="@+id/editPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="#24272C"
            android:hint="Senha do Servidor (Opcional)"
            android:inputType="textPassword"
            android:padding="14dp"
            android:textColor="#DCDFE3"
            android:textColorHint="#5E636A" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#2E7FC4"
            android:padding="12dp"
            android:text="CONECTAR"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#D9534F"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ========================================== -->
    <!-- TELA DO SERVIDOR ATIVO (SALA/VOZ/CHAT)     -->
    <!-- ========================================== -->
    <LinearLayout
        android:id="@+id/layoutServer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2B2E33"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/btnDisconnect"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtServerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conectando..."
                    android:textColor="#DCDFE3"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtMotd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="..."
                    android:textColor="#8B959E"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDisconnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:backgroundTint="#D9534F"
                android:text="Sair"
                android:textColor="#FFFFFF" />

        </RelativeLayout>

        <!-- Barra de Controle de Voz / VAD / Gravação Local -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#24272C"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- Indicador VAD -->
            <View
                android:id="@+id/viewVadLight"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:background="#3E434A" />

            <TextView
                android:id="@+id/txtVoiceStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Silencioso"
                android:textColor="#8B959E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Mute mic -->
            <Button
                android:id="@+id/btnMuteMic"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#3E434A"
                android:text="🎙️"
                android:textColor="#FFFFFF" />

            <!-- Record audio -->
            <Button
                android:id="@+id/btnRecord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#2E7FC4"
                android:text="🔴 Gravar"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- Divisor -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#3E434A" />

        <!-- Canais e Usuários Conectados -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:id="@+id/containerChannels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

        <!-- Divisor -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#3E434A" />

        <!-- Chat do Canal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <ScrollView
                android:id="@+id/scrollChat"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/txtChatBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#DCDFE3"
                    android:textSize="13sp" />

            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/editChatMsg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#24272C"
                    android:hint="Escreva uma mensagem..."
                    android:inputType="text"
                    android:padding="10dp"
                    android:textColor="#DCDFE3"
                    android:textColorHint="#5E636A" />

                <Button
                    android:id="@+id/btnSendChat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#2E7FC4"
                    android:text="Enviar"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
